# Loop Timing Witness — editor configuration

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[Makefile]
indent_style = tab

[{LICENSE,LICENSES/*}]
trim_trailing_whitespace = false
insert_final_newline = unset
