{
  "aggregate_gate": {
    "job": "gate",
    "workflow": "ci.yml"
  },
  "coordinator": "ci.yml",
  "omitted_categories": [
    3,
    5,
    6
  ],
  "schema": "loop-timing-witness.workflow-inventory.v1",
  "schema_version": "1.0.0",
  "size_limits": {
    "max_bytes": 102400,
    "max_lines": 1000
  },
  "workflows": [
    {
      "category": 1,
      "file": "ci.yml",
      "jobs": [
        "gate",
        "static-policy",
        "tests"
      ],
      "kind": "coordinator",
      "owner": "coordinator and stable required gate"
    },
    {
      "category": 2,
      "file": "reusable-static-policy.yml",
      "jobs": [
        "run"
      ],
      "kind": "reusable",
      "owner": "static analysis, manifest, inventory and repository policy"
    },
    {
      "category": 4,
      "file": "reusable-tests.yml",
      "jobs": [
        "run",
        "coverage"
      ],
      "kind": "reusable",
      "owner": "tests with complete statement and branch coverage and source-bound Codecov publication"
    },
    {
      "category": 2,
      "file": "pre-commit.yml",
      "jobs": [
        "pre-commit"
      ],
      "kind": "standalone",
      "owner": "parity with the local pre-commit hooks"
    },
    {
      "category": 8,
      "file": "codeql.yml",
      "jobs": [
        "analyse"
      ],
      "kind": "standalone",
      "owner": "code scanning of native controllers, Python tooling and workflow definitions"
    },
    {
      "category": 8,
      "file": "security-audit.yml",
      "jobs": [
        "audit"
      ],
      "kind": "standalone",
      "owner": "secrets, vulnerabilities, licences and workflow security"
    },
    {
      "category": 8,
      "file": "scorecard.yml",
      "jobs": [
        "analysis"
      ],
      "kind": "standalone",
      "owner": "published supply-chain analysis and code-scanning results"
    },
    {
      "category": 8,
      "file": "sbom.yml",
      "jobs": [
        "inventory"
      ],
      "kind": "standalone",
      "owner": "software inventory of the development lock"
    },
    {
      "category": 9,
      "file": "docs.yml",
      "jobs": [
        "validate",
        "deploy"
      ],
      "kind": "standalone",
      "owner": "strict documentation and authorised main-branch Pages deployment"
    },
    {
      "category": 7,
      "file": "controller-comparison.yml",
      "jobs": [
        "measure"
      ],
      "kind": "standalone",
      "owner": "native comparison measurement and retained runner provenance"
    },
    {
      "category": 10,
      "file": "publish.yml",
      "jobs": [
        "build",
        "publish"
      ],
      "kind": "standalone",
      "owner": "owner-authorised exact-revision Python artifact verification and OIDC publication"
    },
    {
      "category": 10,
      "file": "publish-rust.yml",
      "jobs": [
        "publish"
      ],
      "kind": "standalone",
      "owner": "owner-authorised exact-revision packaged Rust consumers and crates.io publication"
    },
    {
      "category": 11,
      "file": "pypi-downloads.yml",
      "jobs": [
        "verify",
        "snapshot"
      ],
      "kind": "standalone",
      "owner": "exact-head verified daily PyPI history on the isolated metrics data ref"
    },
    {
      "category": 10,
      "file": "source-release-signatures.yml",
      "jobs": [
        "verify",
        "sign",
        "publish"
      ],
      "kind": "standalone",
      "owner": "manual immutable source verification, OIDC signatures and verified signature attachment"
    }
  ]
}
