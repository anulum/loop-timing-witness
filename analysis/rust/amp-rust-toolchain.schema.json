{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compiler",
    "cargo",
    "verbose_version",
    "target",
    "target_libraries",
    "runtime_libraries"
  ],
  "properties": {
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verbose_version": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "const": "riscv64imac-unknown-none-elf"
    },
    "target_libraries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "runtime_libraries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
