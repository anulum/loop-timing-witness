{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.anulum.li/schemas/loop-timing-witness/repeat-campaign-v1.json",
  "title": "Loop Timing Witness repeat campaign manifest",
  "description": "Ordered repeats of one run configuration. Each repeat binds an existing run manifest by path and SHA-256; the campaign adds the repeat index and reboot declaration that a run manifest does not carry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "loop-timing-witness.repeat-campaign.v1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "repeats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repeat_index": {
            "type": "integer",
            "minimum": 1
          },
          "run_manifest": {
            "$ref": "#/$defs/file"
          },
          "rebooted_before_run": {
            "type": "boolean"
          }
        },
        "required": [
          "repeat_index",
          "run_manifest",
          "rebooted_before_run"
        ]
      }
    },
    "operator_notes": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "campaign_id",
    "repeats",
    "operator_notes"
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  }
}
