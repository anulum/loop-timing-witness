# Loop Timing Witness — plant system post-optimisation equivalence

# Component proofs keep arithmetic and queue state in separate SAT cones.
# The integrated wrapper is exercised by the public-port RTL-to-host tests.

design -reset
read_verilog -sv rtl/clock_reset_release.sv rtl/event_record_fifo.sv rtl/fixed_point_math.sv rtl/sampled_plant.sv rtl/reference_generator.sv rtl/deadline_monitor.sv rtl/fault_injector.sv rtl/control_event_capture.sv rtl/control_cycle.sv rtl/control_plant_witness.sv
hierarchy -top fixed_point_math -chparam A 16777216 -chparam B 32'hff000000 -chparam C 16777216
proc
flatten
memory_map
opt
async2sync
opt
design -save gold
opt -full
check -assert
rename fixed_point_math gate
design -stash gate
design -copy-from gold -as gold fixed_point_math
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -short
equiv_induct -seq 8
equiv_status -assert

