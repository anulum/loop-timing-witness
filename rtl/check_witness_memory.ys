# Loop Timing Witness — default witness memory check

read_verilog -sv rtl/clock_reset_release.sv rtl/event_record_capture.sv rtl/event_record_fifo.sv rtl/event_witness.sv
hierarchy -top event_witness
proc
opt
memory_dff
memory_collect
opt_clean
check -assert
select -assert-count 1 t:$mem_v2
stat
